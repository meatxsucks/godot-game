[gd_resource type="Resource" script_class="ClassDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/core/class_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"alchemist"
display_name = "Alquimista"
description = "Un condenado que experimentó consigo mismo hasta quedar en los huesos. Sus frascos de ácido DAÑAN y desangran enemigos mientras CURAN aliados, y su Elixir detona todos los estados en una onda."
color = Color(0.55, 0.9, 0.25, 1)
menu_order = 3
model = "res://assets/kaykit/Skeleton_Mage.glb"
anims = {"idle": "Idle", "run": "Running_A", "attack": "Spellcast_Shoot", "death": "Death_A"}
model_tint = Color(0.72, 1.0, 0.62, 1)
stats = {&"max_health": 115.0, &"max_mana": 130.0, &"mana_regen": 13.0, &"spell_damage": 11.0, &"crit_chance": 5.0}
kit = Array[StringName]([&"dash", &"alchemist_flask", &"shared_elixir"])
